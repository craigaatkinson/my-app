{
    "name": "craig/datastar-app",
    "description": "My Datastar-powered PHP app",
    "type": "project",
    "require": {
      "starfederation/datastar-php": "^1.0@beta",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
      "phpunit/phpunit": "^10.0",
      "mockery/mockery": "^1.5"
    },
    "autoload": {
      "psr-4": {
        "App\\": "src/app/"
      }
    },
    "autoload-dev": {
      "psr-4": {
        "Tests\\": "tests/"
      }
    },
    "scripts": {
      "start": "php -S localhost:8000 -t public",
      "test": "phpunit",
      "test-coverage": "phpunit --coverage-html coverage",
      "db:init": "php scripts/init-database.php",
      "db:import": "php scripts/import-csv.php"
    },
    "suggest": {
      "ext-pdo_sqlite": "Required for SQLite database support",
      "ext-sqlite3": "Alternative SQLite extension"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
  }
